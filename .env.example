MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/devpilot-ai
JWT_SECRET=replace-with-a-long-random-secret

# AI generation limits (the API key stays server-side; configure the real key locally/deployment-side).
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_COMPLETION_TOKENS=32768
OPENAI_REQUEST_TIMEOUT_MS=240000
GENERATION_TOTAL_TIMEOUT_MS=270000
GENERATION_STAGED_MAX_FILES=32
GENERATION_STAGED_MAX_CALLS=24
GENERATION_STAGED_BATCH_SIZE=4
GENERATION_STAGED_MAX_FILE_BYTES=65536
GENERATION_STAGED_MAX_TOTAL_BYTES=1048576

# Cloud file storage for authenticated asset uploads. Keep the API secret server-side only.
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Generic SMTP settings for verification emails.
# Use credentials from your chosen email delivery service, such as Brevo.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-smtp-username
EMAIL_PASSWORD=your-smtp-password
EMAIL_FROM="DevPilot AI <no-reply@your-domain.com>"

# Optional. Number of seconds before a user can request another OTP.
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
