PORT=5000
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/devpilot-ai
JWT_SECRET=replace-with-a-long-random-secret

# AI project generation (backend only; never add these as VITE_* variables).
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_COMPLETION_TOKENS=32768
# Provider request cap and whole-generation deadline (4 min / 4.5 min).
# Keep the total below the Vercel function maxDuration configured in vercel.json.
OPENAI_REQUEST_TIMEOUT_MS=240000
GENERATION_TOTAL_TIMEOUT_MS=270000
GENERATION_STAGED_MAX_FILES=32
GENERATION_STAGED_MAX_CALLS=24
GENERATION_STAGED_BATCH_SIZE=4
GENERATION_STAGED_MAX_FILE_BYTES=65536
GENERATION_STAGED_MAX_TOTAL_BYTES=1048576

# Generic SMTP settings for verification emails.
# Use credentials from your chosen email delivery service.
EMAIL_HOST=smtp.your-email-provider.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-smtp-username
EMAIL_PASSWORD=your-smtp-password
EMAIL_FROM="DevPilot AI <no-reply@your-domain.com>"

# Optional. Number of seconds before a user can request another OTP.
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
